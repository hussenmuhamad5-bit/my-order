# شاردنەوەی هەموو فایلەکان لە Git
*

# ڕێگەدان تەنها بە ٤ فایلە سەرەکییەکە و فایلی ناردن
!app.html
!config.js
!style.css
!index.html
!order-details.html
!.gitignore
!GitHubDeployer.exe
!GitHubDeployer.cs
!push_to_github.bat
!github_config.txt

# کتێبخانە دەرەکییەکان — لەگەڵ ئەپەکەدا دادەنرێن نەک لە CDN.
# لەسەر هەندێک ئینتەرنێت CDNەکان ڕێگریان لێدەکرێت و ئەوکات
# ئایکۆنەکان دەبنە چوارگۆشەی بەتاڵ و هیچ داتایەک نایەت.
!vendor/
!vendor/supabase.min.js
!vendor/css/
!vendor/css/boxicons.min.css
!vendor/fonts/
!vendor/fonts/boxicons.woff2

# فۆنتی ئیمۆجی — ٨٢٧ ئیمۆجی، ١٬٨٩٧KB. بەبێ ئەم دێڕە بێدەنگانە
# ناچێتە سەر سایتەکە و ئیمۆجییەکان دەگەڕێنەوە بۆ شێوازی ئەندرۆید.
!vendor/fonts/emoji.woff2

# ئیمۆجی ڕیاکشنەکان — ١٥ وێنە، ١٢٦KB بە گشتی.
# لە فۆنتێکی ٣٣.٧MB دەرهێنراون؛ تەنها ئەوانەی بەکاردێن.
!vendor/emoji/
!vendor/emoji/*.png

# سکیمای داتابەیس — بە دەست لە Supabase → SQL Editor جێبەجێ دەکرێن،
# بەڵام دەبێت لە Git ـدا بن تا بزانرێت چی جێبەجێ کراوە
!db/
!db/*.sql

# سکریپتی دروستکردنی فۆنتی ئیمۆجی — بە دەست بەڕێدەکرێت،
# ناچێتە سەر سایتەکە بەڵام دەبێت لە Git ـدا بێت
!tools/
!tools/build_emoji_font.py

# ئامرازی ئاژانس — بەڕێوەبردن و پشکنینی ئەپەکە
!.claude/
!.claude/skills/
!.claude/skills/run-my-order/
!.claude/skills/run-my-order/SKILL.md
!.claude/skills/run-my-order/driver.mjs
!.claude/skills/run-my-order/check.mjs

# وێنە گیراوەکان کۆمیت ناکرێن
.claude/skills/run-my-order/shots/
